rules_version = '2';

// Firebase Storage security rules.
//
// Replaces the previous expiring catch-all
//   `allow read, write: if request.time < timestamp.date(2026, 5, 13)`
// which lapsed on 2026-05-13 and silently denied every upload thereafter —
// breaking profile-avatar uploads (App Store build 84 rejection, Guideline
// 2.1a) and challenge-proof uploads.
//
// No expiring conditions and no broad `{allPaths=**}` grant: Storage denies any
// path not matched below by default, so only the two paths the app actually
// writes are permitted, each owner-scoped.
service firebase.storage {
  match /b/{bucket}/o {
    // Profile avatars — one fixed object per user.
    //   StorageService.uploadProfilePicture -> profiles/{uid}.jpg
    // Owner-only write: the filename must be the caller's uid + ".jpg".
    // Any authenticated user may read (avatars are shown throughout the
    // auth-gated community, and getDownloadURL() after upload needs read).
    match /profiles/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg';
    }

    // Challenge proof photos.
    //   StorageService.uploadChallengeProof
    //     -> challenges/{challengeId}/proofs/{uid}/{yyyyMMdd}.jpg
    // Owner-only write (the uid segment must be the caller); any authenticated
    // user may read (proofs are shown to other challenge participants).
    match /challenges/{challengeId}/proofs/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
