# DrillFit environment configuration — TEMPLATE.
# Copy to assets/.env and fill in real values. assets/.env is gitignored and
# must NEVER be committed. Do not paste real keys into chats, issues, or PRs.
#
# IMPORTANT: This file has no leading byte-order mark (BOM). flutter_dotenv does
# not strip BOMs, so a BOM on line 1 makes the first variable unreadable.

# --- AI Coach ---------------------------------------------------------------
# PREFERRED: deploy the aiProxy Cloud Function (see functions/index.js) and put
# its URL here. The Anthropic key then lives only on the backend and the app
# authenticates with its Firebase ID token — nothing secret ships in the bundle.
AI_PROXY_URL=

# DEV-ONLY fallback. Used only when AI_PROXY_URL is empty. A key here is baked
# into the app bundle and is extractable from any release build — never ship a
# production app this way.
ANTHROPIC_API_KEY=

# --- Nutrition data providers ----------------------------------------------
USDA_API_KEY=
SPOONACULAR_API_KEY=

# --- Supplement data provider ----------------------------------------------
# Same exposure caveat as the Anthropic key — route through a backend before
# shipping a public release.
SUPPLEMENT_API_TOKEN=
