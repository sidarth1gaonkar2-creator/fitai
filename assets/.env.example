# DrillFit environment configuration — TEMPLATE.
# Copy to assets/.env and fill in real values. assets/.env is gitignored and
# must NEVER be committed. Do not paste real keys into chats, issues, or PRs.
#
# IMPORTANT: This file has no leading byte-order mark (BOM). flutter_dotenv does
# not strip BOMs, so a BOM on line 1 makes the first variable unreadable.

# --- AI Coach ---------------------------------------------------------------
# Deploy the aiProxy Cloud Function (see functions/index.js) and put its URL
# here. The Anthropic key lives ONLY in Google Secret Manager on the backend
# (firebase functions:secrets:set ANTHROPIC_API_KEY) and is never bundled into
# the app — calls authenticate with the user's Firebase ID token. If AI_PROXY_URL
# is empty the AI Coach is disabled; there is no on-device key fallback.
AI_PROXY_URL=

# --- Account deletion -------------------------------------------------------
# Deploy the deleteAccount Cloud Function (see functions/index.js) and put its
# URL here. It verifies the user's Firebase ID token, then tears down the
# account + ALL of their data (Firestore docs, Storage objects) via the Admin
# SDK and deletes the auth user. If DELETE_ACCOUNT_URL is empty the in-app
# "Delete Account" action fails with a user-safe message instead of calling a
# bad URL.
DELETE_ACCOUNT_URL=

# --- Nutrition data providers ----------------------------------------------
USDA_API_KEY=
SPOONACULAR_API_KEY=

# --- Supplement data provider ----------------------------------------------
# Same exposure caveat as the Anthropic key — route through a backend before
# shipping a public release.
SUPPLEMENT_API_TOKEN=
